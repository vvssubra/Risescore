# Copy to .env (never commit). In production the two secrets below are REQUIRED.
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://scorecard.example.com
# Behind a reverse proxy/CDN set to the number of proxy hops (e.g. 1) so client IPs are correct for rate limiting.
TRUST_PROXY=1

# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# openssl rand -base64 48
SIGNING_SECRET=

# REQUIRED in production. Dev/test without it uses embedded Postgres (PGlite) under DATA_DIR/pgdata.
DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=require        # off | require (encrypted, no cert check) | verify
# DATABASE_POOL_MAX=10
# PDFs are stored in Postgres by default. STORAGE_DRIVER=fs + STORAGE_DIR=/path to use a mounted disk instead.
DATA_DIR=./data

# First admin without shell access (only used when no admin exists yet; forces a password change; remove after first sign-in).
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# immediate = report link returned right after the gate; email_verified = only via the emailed one-time link
REPORT_ACCESS_MODE=immediate
REPORT_TTL_DAYS=30
ASSESSMENT_RETENTION_DAYS=90
REPORT_RETENTION_DAYS=365
SIGNED_URL_TTL_SECONDS=600

MAX_PDF_MB=15
REQUIRE_SEPARATE_REVIEWER=true

# Transactional email: the server POSTs {from,to,subject,text} as JSON to this URL (any provider/function). Unset = emails stay queued.
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=
MAIL_FROM="R.I.S.E. Scorecard <no-reply@example.com>"

WHATSAPP_NUMBER=60122202217

# Staging only: puts the whole site behind HTTP Basic auth (user:password, 12+ char password). Health check excluded.
# STAGING_BASIC_AUTH=staging:change-this-long-password
