{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist/server",
    "rootDir": "src",
    "lib": ["ES2023"]
  },
  "include": ["src/server", "src/shared"]
}
