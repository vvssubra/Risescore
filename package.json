{
  "name": "rise-scorecard",
  "version": "0.1.0",
  "private": true,
  "description": "R.I.S.E.™ Financial and Career & Income scorecard — standalone application by Balla DK",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:scoring": "vitest run tests/scoring.test.ts",
    "test:toolkits": "vitest run tests/toolkits.test.ts",
    "test:e2e": "npm run build:client && playwright test",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "purge": "tsx scripts/purge.ts",
    "launch-check": "tsx scripts/launch-check.ts",
    "build:client": "vite build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
